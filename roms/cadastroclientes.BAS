10 CLEAR 1000
20 COLOR 15,1,1: CLS
30 DIM NM$(50), TL$(50)
40 CT = 0
50 CLS
60 PRINT "BEM VINDO AO CADASTRO DE CLIENTES"
70 PRINT "1 - CADASTRAR CLIENTE"
80 PRINT "2 - CONSULTAR CLIENTES"
90 PRINT "3 - SAIR"
100 INPUT "OPCAO: "; OP
110 IF OP = 1 THEN GOTO 150
120 IF OP = 2 THEN GOTO 220
130 IF OP = 3 THEN GOTO 300 ELSE GOTO 50
150 CLS
160 IF CT >= 50 THEN PRINT "LIMITE ATINGIDO!": GOTO 200
170 CT = CT + 1
180 PRINT "CADASTRO DE CLIENTE #"; CT
190 INPUT "Nome: "; NM$(CT)
200 INPUT "Telefone: "; TL$(CT)
210 PRINT "Cadastrado com sucesso!": FOR I=1 TO 1000: NEXT I: GOTO 50
220 CLS
230 PRINT "CONSULTAR CLIENTES"
240 IF CT = 0 THEN PRINT "Nenhum cliente cadastrado.": GOTO 280
250 FOR I = 1 TO CT
260 PRINT I; "- "; NM$(I); " | "; TL$(I)
270 NEXT I
280 PRINT: INPUT "Pressione ENTER para voltar..."; LK$
290 GOTO 50
300 END